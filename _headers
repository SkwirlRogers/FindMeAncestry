/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=86400

/api/*
  Cache-Control: no-store

# Allow only the Scout and Assettie assistant pages to be embedded by FYBF.
# Include both extension and extensionless routes because the site redirects
# the .html URLs to their canonical extensionless paths.
/scout_chat.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://findyourbabyfamily.com https://www.findyourbabyfamily.com

/scout_chat
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://findyourbabyfamily.com https://www.findyourbabyfamily.com

/assetie_chat.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://findyourbabyfamily.com https://www.findyourbabyfamily.com

/assetie_chat
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://findyourbabyfamily.com https://www.findyourbabyfamily.com
